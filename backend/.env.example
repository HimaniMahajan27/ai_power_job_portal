# Backend environment configuration template
# Copy this file to .env and fill in your actual values
# DO NOT commit your .env file to source control

# MongoDB Connection
# Local: mongodb://localhost:27017/job-portal
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/job-portal

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Secrets (use long random strings - minimum 32 characters recommended)
JWT_SECRET=replace_with_a_long_random_secret
SESSION_SECRET=replace_with_a_long_random_secret

# Google OAuth (optional - required only if using Google login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# AI provider keys (optional but recommended for best features)
# Get Gemini API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Get Groq API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# Setup Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values in .env
# 3. Never commit .env to git
# 4. Restart backend after changes: npm run dev
